# Required
REPO_ROOT=/absolute/path/to/your/repository

# read | write | test
MCP_MODE=read

# stdio | streamable-http
MCP_TRANSPORT=stdio

# Common limits
MAX_FILE_BYTES=200000
MAX_PATCH_BYTES=200000
MAX_SEARCH_RESULTS=50
MAX_OUTPUT_BYTES=20000
ALLOW_DIRTY_WORKTREE=false
AUDIT_LOG=
TEST_TIMEOUT_MAX=300

# Streamable HTTP only
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
HTTP_PATH=/mcp
HTTP_AUTH_MODE=none
HTTP_AUTH_TOKEN=
HTTP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
HTTP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
HTTP_JSON_RESPONSE=true
HTTP_STATELESS=true
HTTP_MAX_REQUEST_BYTES=262144

# Secure MCP Tunnel runtime secret. Do not put a real value in this file.
# CONTROL_PLANE_API_KEY=
