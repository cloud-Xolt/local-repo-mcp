[Unit]
Description=OpenAI Secure MCP Tunnel Client for Local Repo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=repo-mcp
Group=repo-mcp
Environment=CONTROL_PLANE_API_KEY=sk-REPLACE_ME
ExecStart=/usr/local/bin/tunnel-client run --profile local-repo
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tunnel-client /var/log/tunnel-client /opt/local-repo-mcp /opt/repos/project-a

[Install]
WantedBy=multi-user.target
