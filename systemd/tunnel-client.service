[Unit]
Description=OpenAI Secure MCP Tunnel Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=repo-mcp
Group=repo-mcp
EnvironmentFile=/etc/local-repo-mcp/tunnel.env
ExecStart=/usr/local/bin/tunnel-client run --profile local-repo
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tunnel-client

[Install]
WantedBy=multi-user.target
