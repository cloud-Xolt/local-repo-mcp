# Core repository boundary
REPO_ROOT=/opt/repos/target-repo
MCP_MODE=read
MCP_TRANSPORT=streamable-http
ALLOW_DIRTY_WORKTREE=false
AUDIT_LOG=/var/log/local-repo-mcp/audit.jsonl
MCP_LOG=/var/log/local-repo-mcp/mcp.jsonl
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3
MAX_FILE_BYTES=200000
MAX_PATCH_BYTES=200000
MAX_SEARCH_RESULTS=50
MAX_OUTPUT_BYTES=20000
TEST_TIMEOUT_MAX=300

# HTTP boundary shared by native TLS and reverse-proxy deployments.
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
HTTP_PATH=/mcp
HTTP_PUBLIC_URL=https://mcp.example.com/mcp
HTTP_AUTH_MODE=bearer
HTTP_AUTH_TOKEN=replace-with-a-long-random-token
HTTP_ALLOWED_HOSTS=mcp.example.com
HTTP_ALLOWED_ORIGINS=https://mcp.example.com
HTTP_MAX_REQUEST_BYTES=262144
HTTP_JSON_RESPONSE=true
HTTP_STATELESS=true

# Mode A: native HTTPS on Local Repo MCP.
HTTP_TLS_CERTFILE=/etc/local-repo-mcp/tls/fullchain.pem
HTTP_TLS_KEYFILE=/etc/local-repo-mcp/tls/privkey.pem
# Optional mutual TLS:
# HTTP_TLS_CLIENT_CA=/etc/local-repo-mcp/tls/client-ca.pem
HTTP_TLS_TERMINATED_PROXY=false
HTTP_PROXY_TRUSTED_IPS=127.0.0.1

# Mode B: TLS terminates at a trusted reverse proxy.
# Comment out HTTP_TLS_CERTFILE and HTTP_TLS_KEYFILE above, then use:
# HTTP_TLS_TERMINATED_PROXY=true
# HTTP_PROXY_TRUSTED_IPS=127.0.0.1,10.0.0.0/8
#
# The backend may bind to loopback, a private address, or a container/pod
# wildcard address. Network policy or firewall rules must prevent direct
# untrusted access to the backend.
